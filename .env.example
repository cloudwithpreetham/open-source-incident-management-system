# IncidentFlow Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-secure-random-key-in-production

# Database configuration (defaults to incidents.db)
INCIDENT_DB_PATH=incidents.db

# Email / SMTP Alert Configuration
ENABLE_SMTP=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=devops-alerts@internal.company.com
